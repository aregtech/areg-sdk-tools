<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<StateMachine FormatVersion="1.1.0">
    <Overview ID="1" Name="GuardDemo" Version="1.0.0" Threading="Local">
        <Description>SM-21 (U2) guard-editor demo machine. Carries the running-example symbol
            universe (attributes, a constant, a stimulus with a parameter, a handler condition
            and a named lambda) plus my_condition(limit:uint32, delta:int32) whose parameter
            types each have a unique exact-type attribute, so auto-map fills both slots.</Description>
    </Overview>
    <AttributeList>
        <Attribute ID="10" Name="WalkRequested" DataType="bool" Value="">
            <Description>Whether a walk was requested.</Description>
        </Attribute>
        <Attribute ID="11" Name="IsNightMode" DataType="bool" Value="">
            <Description>Whether the machine is in night mode.</Description>
        </Attribute>
        <Attribute ID="12" Name="Backlog" DataType="uint32" Value="">
            <Description>The pending-request backlog (the only uint32 symbol).</Description>
        </Attribute>
        <Attribute ID="13" Name="Delta" DataType="int32" Value="">
            <Description>A signed adjustment (the only int32 symbol).</Description>
        </Attribute>
    </AttributeList>
    <MethodList>
        <Method ID="30" Name="request_walk" MethodType="Trigger">
            <Description>Requests a walk; carries the waiting count.</Description>
            <ParamList>
                <Parameter ID="31" Name="count" DataType="uint16">
                    <Description>The number of waiting pedestrians.</Description>
                </Parameter>
            </ParamList>
        </Method>
        <Method ID="32" Name="has_waiting" MethodType="Condition" Return="bool" Implement="Handler">
            <Description>Handler condition: whether enough pedestrians are waiting.</Description>
            <ParamList>
                <Parameter ID="33" Name="count" DataType="uint16">
                    <Description>The waiting count to test.</Description>
                </Parameter>
            </ParamList>
        </Method>
        <Method ID="34" Name="is_calm_hours" MethodType="Condition" Return="bool" Implement="Embedded">
            <Description>Named lambda condition: whether the count is below the minimum.</Description>
            <ParamList>
                <Parameter ID="35" Name="count" DataType="uint16">
                    <Description>The waiting count to test.</Description>
                </Parameter>
            </ParamList>
            <Body><![CDATA[return count < MIN_WAITING;]]></Body>
        </Method>
        <Method ID="36" Name="my_condition" MethodType="Condition" Return="bool" Implement="Handler">
            <Description>Handler condition whose two parameters each have a unique exact-type
                attribute (Backlog : uint32, Delta : int32), so auto-map fills both slots.</Description>
            <ParamList>
                <Parameter ID="37" Name="limit" DataType="uint32">
                    <Description>An upper bound (matches Backlog).</Description>
                </Parameter>
                <Parameter ID="38" Name="delta" DataType="int32">
                    <Description>A signed delta (matches Delta).</Description>
                </Parameter>
            </ParamList>
        </Method>
    </MethodList>
    <ConstantList>
        <Constant ID="20" Name="MIN_WAITING" DataType="uint16" Value="3">
            <Description>The minimum waiting count before a walk is granted.</Description>
        </Constant>
    </ConstantList>
    <StateList>
        <State ID="43" Name="Start" Kind="Start">
            <TransitionList>
                <Transition ID="44" Kind="Initial" To="40"/>
            </TransitionList>
        </State>
        <State ID="40" Name="Idle" Kind="Normal">
            <Description>Waiting for a walk request.</Description>
            <TransitionList>
                <Transition ID="41" Kind="External" StimulusKind="Trigger" Stimulus="request_walk" To="42">
                    <Description>A walk was requested; the guard decides whether to cross.</Description>
                </Transition>
            </TransitionList>
        </State>
        <State ID="42" Name="Walking" Kind="Normal">
            <Description>The pedestrians are crossing.</Description>
        </State>
    </StateList>
    <Layout GridSize="16" GridVisible="true">
        <ViewList>
            <View Owner="1" Zoom="100" X="0" Y="0"/>
        </ViewList>
        <NodeList>
            <Node Owner="40" X="120" Y="140" Width="160" Height="64"/>
            <Node Owner="42" X="440" Y="140" Width="160" Height="64"/>
            <Node Owner="43" X="120" Y="60" Width="64" Height="32"/>
        </NodeList>
        <EdgeList>
            <Edge Owner="41">
                <Point X="280" Y="172"/>
                <Point X="440" Y="172"/>
                <Label X="330" Y="152"/>
            </Edge>
        </EdgeList>
    </Layout>
</StateMachine>
