/*
 * Lusan application theme template.
 * The ${token} placeholders are replaced at runtime with theme colors,
 * see NEAppThemes::themeStyleSheet(). Widget backgrounds and text colors
 * come from QPalette (Fusion style); this sheet adds the modern accents.
 */

QMdiArea
{
    background: ${window};
}

QScrollArea
{
    border: none;
    background: transparent;
}

QToolTip
{
    background-color: ${base};
    color: ${text};
    border: 1px solid ${border};
    padding: 4px 6px;
}

/* ---- Buttons ---- */

QPushButton
{
    background-color: ${button};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 4px 14px;
    min-height: 18px;
}

QPushButton:hover
{
    background-color: ${hover};
    border-color: ${accent};
}

QPushButton:pressed
{
    background-color: ${pressed};
}

QPushButton:default
{
    border-color: ${accent};
}

QPushButton:disabled
{
    color: ${muted};
    background-color: transparent;
}

QPushButton[flat="true"]
{
    background: transparent;
    border: none;
}

QToolButton
{
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px;
}

QToolButton:hover
{
    background: ${hover};
    border-color: ${border};
}

/* A checked tool button is a mode that stays on (the armed canvas tool, a grid toggle), so it
   needs more than a background tint to read at icon-only sizes: an accent border marks it. */
QToolButton:pressed, QToolButton:checked
{
    background: ${pressed};
    border-color: ${accent};
}

/* Split buttons (MenuButtonPopup): keep the drop-down zone on the same background as the
   button itself. Reserve a dedicated right-side area for the arrow, but avoid a hard
   divider line so the button keeps a classic unified look. */
QToolButton::menu-button
{
    background: transparent;
    border: none;
    subcontrol-origin: padding;
    width: 12px;
    margin: 0px;
    margin-left: 2px;
}

QToolButton::menu-arrow
{
    image: url(${arrow});
    width: 10px;
    height: 10px;
}

/* Text split button in the Structure lens (the [+ and v] add button). A text-only
   MenuButtonPopup tool button does not reserve room for the drop-down arrow, so the
   chevron paints on top of the label. Reserve right-side padding wider than the
   menu-button zone (12px + 2px margin) so the label stays clear and the chevron
   follows it. */
QToolButton#smLensAdd
{
    padding-left: 6px;
    padding-right: 18px;
}

/* ---- Text inputs ---- */

QLineEdit, QPlainTextEdit, QTextEdit
{
    background-color: ${base};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 3px 6px;
    selection-background-color: ${accent};
    selection-color: ${onAccent};
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus
{
    border-color: ${accent};
}

QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled
{
    color: ${muted};
}

/* ---- Combo boxes ---- */

QComboBox
{
    background-color: ${base};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 3px 8px;
    min-height: 18px;
    /* Force the list-view drop-down. The default menu-mode popup ignores the ::item rules
       below (highlight becomes unreadable) and anchors itself to the row last hovered,
       shifting position on every reopen. */
    combobox-popup: 0;
}

QComboBox:hover, QComboBox:focus
{
    border-color: ${accent};
}

QComboBox:disabled
{
    color: ${muted};
}

QComboBox::drop-down
{
    border: none;
    width: 22px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow
{
    image: url(${arrow});
    width: 12px;
    height: 12px;
}

/* The canvas zoom box and the two step arrows share their line with the horizontal scrollbar,
   so all three are exactly as tall as it is. That leaves no room for the padding, the minimum
   height or the frame the other combo boxes and tool buttons carry: a border would add its two
   pixels back and the line would no longer match the vertical scrollbar. They mark themselves
   on hover with a background instead, which costs no height. */
QComboBox#smCanvasZoom
{
    background: transparent;
    border: none;
    padding: 0px 2px;
    min-height: 12px;
    max-height: 12px;
}

QComboBox#smCanvasZoom:hover, QComboBox#smCanvasZoom:focus
{
    background: ${hover};
}

/* The editor of that box is a QLineEdit and would take the frame and the padding every other
   text field has. On a line this short the padding alone is most of the height and cuts the
   top and the bottom off the percentage. */
QComboBox#smCanvasZoom QLineEdit
{
    background: transparent;
    border: none;
    padding: 0px;
}

QComboBox#smCanvasZoom::drop-down
{
    width: 12px;
}

QComboBox#smCanvasZoom::down-arrow
{
    width: 8px;
    height: 8px;
}

QToolButton#smCanvasStepLeft, QToolButton#smCanvasStepRight,
QToolButton#smCanvasStepUp, QToolButton#smCanvasStepDown
{
    background: transparent;
    border: none;
    padding: 0px;
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
}

QToolButton#smCanvasStepLeft:hover, QToolButton#smCanvasStepRight:hover,
QToolButton#smCanvasStepUp:hover, QToolButton#smCanvasStepDown:hover,
QToolButton#smCanvasStepLeft:pressed, QToolButton#smCanvasStepRight:pressed,
QToolButton#smCanvasStepUp:pressed, QToolButton#smCanvasStepDown:pressed
{
    background: ${hover};
    border: none;
}

QComboBox QAbstractItemView
{
    background-color: ${base};
    border: 1px solid ${border};
    selection-background-color: ${accent};
    selection-color: ${onAccent};
    outline: none;
}

QComboBox QAbstractItemView::item
{
    background-color: ${base};
    color: ${text};
    padding: 3px 8px;
}

QComboBox QAbstractItemView::item:hover
{
    background-color: ${hover};
    color: ${text};
}

QComboBox QAbstractItemView::item:selected
{
    background-color: ${accent};
    color: ${onAccent};
}

/* ---- Tabs ---- */

QTabWidget::pane
{
    border: 1px solid ${border};
    border-radius: 6px;
}

QTabBar::tab
{
    background: transparent;
    color: ${muted};
    border: 1px solid transparent;
    padding: 5px 14px;
    margin: 2px;
    border-radius: 6px;
}

QTabBar::tab:hover
{
    background: ${hover};
    color: ${text};
}

QTabBar::tab:selected
{
    background: ${base};
    color: ${accent};
    border-color: ${border};
}

/* ---- Item views ---- */

QTreeView, QTableView, QListView
{
    background-color: ${base};
    alternate-background-color: ${alt};
    border: 1px solid ${border};
    border-radius: 6px;
    gridline-color: ${border};
    selection-background-color: ${accent};
    selection-color: ${onAccent};
    outline: none;
}

QHeaderView::section
{
    background-color: ${panel};
    color: ${muted};
    border: none;
    border-bottom: 1px solid ${border};
    border-right: 1px solid ${border};
    padding: 4px 8px;
}

/* ---- Containers ---- */

QGroupBox
{
    border: 1px solid ${border};
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 4px;
}

QGroupBox::title
{
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: ${muted};
}

QSplitter::handle
{
    background: ${border};
}

QDockWidget::title
{
    background: ${panel};
    padding: 6px;
}

/* ---- Menus, toolbars, status bar ---- */

QMenuBar
{
    background-color: ${panel};
    border-bottom: 1px solid ${border};
}

QMenuBar::item
{
    padding: 4px 10px;
    border-radius: 4px;
    background: transparent;
}

QMenuBar::item:selected
{
    background: ${hover};
}

QMenu
{
    background-color: ${base};
    border: 1px solid ${border};
    padding: 4px;
}

QMenu::item
{
    padding: 5px 24px 5px 12px;
    border-radius: 4px;
}

QMenu::item:selected
{
    background-color: ${accent};
    color: ${onAccent};
}

QMenu::item:disabled
{
    color: ${muted};
}

QMenu::separator
{
    height: 1px;
    background: ${border};
    margin: 4px 8px;
}

QToolBar
{
    background: ${panel};
    border: none;
    spacing: 2px;
    padding: 2px;
}

QStatusBar
{
    background: ${panel};
    border-top: 1px solid ${border};
}

/* ---- Scroll bars ---- */

QScrollBar:vertical
{
    background: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical
{
    background: ${scroll};
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover
{
    background: ${scrollHover};
}

QScrollBar:horizontal
{
    background: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:horizontal
{
    background: ${scroll};
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover
{
    background: ${scrollHover};
}

QScrollBar::add-line, QScrollBar::sub-line
{
    height: 0px;
    width: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page
{
    background: transparent;
}

/* ---- Service interface / state machine overview quick links ---- */

QPushButton#linkDataTypes, QPushButton#linkAttributes, QPushButton#linkMethods,
QPushButton#linkConstants, QPushButton#linkIncludes,
QPushButton#smLinkDataTypes, QPushButton#smLinkAttributes, QPushButton#smLinkEvents,
QPushButton#smLinkMethods, QPushButton#smLinkConstants, QPushButton#smLinkIncludes,
QPushButton#smLinkDesign
{
    background: transparent;
    border: none;
    color: ${accent};
    text-align: left;
    padding: 2px 4px;
}

QPushButton#linkDataTypes:hover, QPushButton#linkAttributes:hover, QPushButton#linkMethods:hover,
QPushButton#linkConstants:hover, QPushButton#linkIncludes:hover,
QPushButton#smLinkDataTypes:hover, QPushButton#smLinkAttributes:hover, QPushButton#smLinkEvents:hover,
QPushButton#smLinkMethods:hover, QPushButton#smLinkConstants:hover, QPushButton#smLinkIncludes:hover,
QPushButton#smLinkDesign:hover
{
    color: ${accentHover};
}

/* ---- Dock drop guides ---- */

/*
 * The docking library ships no rule for the drop-guide icons, so they fall back to a
 * palette default where the arrow and the icon body are both QPalette::Base -- the arrow
 * is painted in its own background colour and the guides read as blank plates. Naming the
 * five colours here is the documented way to override them. Overlay and Shadow are given
 * opaque values on purpose: the library re-applies its own alpha to any opaque value.
 */
ads--CDockOverlayCross
{
    qproperty-iconColors: "Frame=${accent} Background=${base} Overlay=${accent} Arrow=${accent} Shadow=${border}";
}

/* ---- Dock splitter handles ---- */

/*
 * The grab area between a dock and the editor is invisible with the stock style, so the
 * only way to find it is to sweep the mouse until the cursor changes. A line down the
 * middle of the handle marks it, and it lights up on hover, the way a resize affordance
 * has to. The handle is deliberately wider than the line it draws: 6px is comfortable to
 * hit, while the 1px line keeps the seam visually thin.
 */
ads--CDockSplitter::handle
{
    background: ${panel};
}

ads--CDockSplitter::handle:horizontal
{
    width: 6px;
    border-left: 1px solid ${border};
}

ads--CDockSplitter::handle:vertical
{
    height: 6px;
    border-top: 1px solid ${border};
}

ads--CDockSplitter::handle:hover
{
    background: ${accent};
}
